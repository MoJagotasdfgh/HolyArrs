+package main
+
+// HolyArrs fork, check for patch 003 (Windows service mode): the command is
+// there, refuses to run by hand, needs -config and defaults to 127.0.0.1.
+
+import (
+	"os"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestForkCheck003Args(t *testing.T) {
+	t.Setenv(EnvAddr, "")
+	t.Setenv(EnvPort, "")
+	if _, _, err := forkServiceArgs([]string{"-name", "X"}); err == nil {
+		t.Fatal("a service without -config was accepted")
+	}
+	name, rest, err := forkServiceArgs([]string{"-name", "HolyArrsMod", "-config", `D:\Media\config`})
+	if err != nil || name != "HolyArrsMod" || !slices.Equal(rest, []string{"-addr", "127.0.0.1:" + defaultPort, "-config", `D:\Media\config`}) {
+		t.Fatalf("%q %q %v", name, rest, err)
+	}
+	if c, err := parseFlags(rest, os.Stderr); err != nil || c.Addr != "127.0.0.1:"+defaultPort || c.ConfigDir != `D:\Media\config` {
+		t.Fatalf("parsed %+v %v", c, err)
+	}
+	name, rest, _ = forkServiceArgs([]string{"-name=Other", "-config=C:\\c", "-addr", "127.0.0.1:7000"})
+	if name != "Other" || slices.Contains(rest, "127.0.0.1:"+defaultPort) {
+		t.Fatalf("%q %q", name, rest)
+	}
+	if name, _, _ := forkServiceArgs([]string{"-config", "c"}); name != forkServiceDefaultName {
+		t.Fatalf("default name %q", name)
+	}
+}
+
+func TestForkCheck003RefusesByHand(t *testing.T) {
+	if _, ok := forkCommands["service"]; !ok {
+		t.Fatal("service command missing")
+	}
+	if code, ok := forkCommand([]string{"service", "-config", t.TempDir()}); !ok || code != 2 {
+		t.Fatalf("by hand: code %d ok %v, want 2", code, ok)
+	}
+	if code := forkExitCode(errRestart); code != exitRestart {
+		t.Fatalf("restart code %d", code)
+	}
+}
+
+func TestForkCheck003WindowsSide(t *testing.T) {
+	src, err := os.ReadFile("fork_service_windows.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"svc.Run(name, h)", "svc.IsWindowsService()", "svc.AcceptStop | svc.AcceptShutdown"} {
+		if !strings.Contains(string(src), want) {
+			t.Fatalf("service mode lost %q", want)
+		}
+	}
+}
diff --git a/app/backend/cmd/holyarrs/fork_service.go b/app/backend/cmd/holyarrs/fork_service.go
new file mode 100644
index 0000000..a5da3d8
--- /dev/null
+++ b/app/backend/cmd/holyarrs/fork_service.go
@@ -0,0 +1,79 @@
+package main
+
+// HolyArrs fork (MoJagotasdfgh/HolyArrs), patch 003: Windows service mode.
+//
+//	holyarrs.exe service -name <service name> -config <folder> [server flags]
+//
+// The Service Control Manager starts the program with these words (the
+// service is created with them in its command line); started by hand it
+// refuses. -config is required (the /config default means nothing on
+// Windows), and with no -addr and no HOLYARRS_ADDR or HOLYARRS_PORT the
+// server listens on 127.0.0.1 only. Stop and shutdown end the server
+// cleanly; a restart or exit asked for from the controls ends the service
+// with that code, so the service's recovery setting starts it again.
+
+import (
+	"errors"
+	"os"
+	"strings"
+)
+
+// forkServiceDefaultName is the service name when -name is not given.
+const forkServiceDefaultName = "HolyArrs"
+
+func init() {
+	forkPatches = append(forkPatches, "003-windows-service")
+	forkCommands["service"] = forkService
+}
+
+// forkServiceArgs takes -name out of args and returns the service name and
+// the server flags, with -addr 127.0.0.1:<port> added when nothing sets the
+// address.
+func forkServiceArgs(args []string) (string, []string, error) {
+	name := forkServiceDefaultName
+	var rest []string
+	hasConfig, hasAddr := false, false
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case a == "-name" || a == "--name":
+			if i+1 >= len(args) || strings.TrimSpace(args[i+1]) == "" {
+				return "", nil, errors.New("-name needs a service name")
+			}
+			name = args[i+1]
+			i++
+			continue
+		case strings.HasPrefix(a, "-name=") || strings.HasPrefix(a, "--name="):
+			name = a[strings.Index(a, "=")+1:]
+			if strings.TrimSpace(name) == "" {
+				return "", nil, errors.New("-name needs a service name")
+			}
+			continue
+		}
+		f := strings.TrimLeft(a, "-")
+		hasConfig = hasConfig || f == "config" || strings.HasPrefix(f, "config=")
+		hasAddr = hasAddr || f == "addr" || strings.HasPrefix(f, "addr=")
+		rest = append(rest, a)
+	}
+	if !hasConfig {
+		return "", nil, errors.New("-config <folder> is required for a service")
+	}
+	if !hasAddr && strings.TrimSpace(os.Getenv(EnvAddr)) == "" && strings.TrimSpace(os.Getenv(EnvPort)) == "" {
+		rest = append([]string{"-addr", "127.0.0.1:" + defaultPort}, rest...)
+	}
+	return name, rest, nil
+}
+
+// forkExitCode turns serve's end into the program's exit code, as main does.
+func forkExitCode(err error) int {
+	var ex errAppExit
+	switch {
+	case err == nil:
+		return 0
+	case errors.Is(err, errRestart):
+		return exitRestart
+	case errors.As(err, &ex):
+		return ex.code
+	}
+	return 1
+}
